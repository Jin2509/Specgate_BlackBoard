' Shows the workspace domain model as stored by backend/app/ws/models.py (tables ws_*).
@startuml cls-domain
!include ../_style.iuml
hide circle
title SpecGate: sơ đồ lớp miền dữ liệu (bảng ws_* trong backend)
hide empty methods
left to right direction

package "Danh tính" {
  class User <<ws_users>> {
    id: str
    display_name: str[40]
    last_workspace_id: str?
    created_at: datetime
  }
  class OAuthAccount <<ws_oauth_accounts>> {
    provider: google | github | email
    subject: str
    login: str
    --
    unique(provider, subject)
  }
  class EmailCode <<ws_email_codes>> {
    email: str[254]
    code_hash: str <<HMAC, không lưu mã>>
    attempt_count: int
    created_at, expires_at: datetime
    consumed_at: datetime?
  }
}

package "Workspace riêng" {
  class ProviderKey <<ws_provider_keys>> {
    provider: anthropic | openai-compatible
    base_url: str?
    secret: bytes <<Fernet, chỉ ghi>>
    key_last4: str[4]
    model: str
    models: str[]
  }
  class Conversation <<ws_conversations>> {
    id: str
    title: str[80]
    workspace_id: str? <<ngữ cảnh nhóm>>
    updated_at: datetime
  }
  class Turn <<ws_turns>> {
    seq: int
    role: user | assistant
    text: str
    model: str?
    error: str? <<lượt lỗi, không gửi lại>>
    stopped: bool
    version_group: str? <<"Tạo lại">>
    active: bool <<phiên bản đang hiện>>
    context_workspace_id: str?
  }
  class PrivateHighlight <<ws_private_highlights>> {
    kind: passage | summary | digest
    speaker_kind: agent | human
    model: str? <<mô hình lúc tạo>>
    original_text: str
    text: str <<sửa được>>
    source_text: str? <<cả lượt gốc>>
    context_workspace_ids: str[]
    color: str
    note: str?
    attached_turns: json[] <<tối đa 4>>
    sends: json[] <<workspace, kênh, tin, lúc>>
    conversation_deleted: bool
  }
  class ContextDigest <<ws_context_digests>> {
    upto_seq: int
    count: int
    blocks: json[] <<cắt tại mốc highlight>>
    model: str?
    --
    unique(user_id, workspace_id)
  }
}

package "Workspace chung" {
  class Workspace <<ws_workspaces>> {
    id: str
    kind: personal | shared
    name: str[80]
    brief: str <<đề bài>>
    visibility: hidden | discoverable
    join_code: str[7]? <<unique>>
    board_seq: int
    task_seq: int
    tasks_locked: bool
  }
  class Member <<ws_members>> {
    role: owner | member
    team_role: str[40]?
    nickname: str[40]?
    needs_nickname: bool
    color: int <<không trùng trong ws>>
    left_at: datetime? <<"(đã rời)">>
    --
    unique(workspace_id, user_id)
  }
  class JoinRequest <<ws_join_requests>> {
    via: code | explore
    code: str?
    message: str
    status: pending | approved\n| rejected | cancelled
    decided_by: str?
  }
  class Channel <<ws_channels>> {
    name: str[40]
    --
    unique(workspace_id, name)
  }
  class ChannelRead <<ws_channel_reads>> {
    last_seq: int <<chấm chưa đọc>>
  }
  class Message <<ws_messages>> {
    seq: int <<thứ tự, nối lại SSE>>
    sender_kind: human | agent | system
    sender_id: str
    agent_model: str? <<mô hình lúc gửi>>
    text: str
    body: segment[]
    reply_to_id: str?
    cards: json[] <<quote | conversation-summary, bản chụp>>
  }
  class Highlight <<ws_highlights>> {
    label: important | review
    note: str? <<Ghi chú của tôi>>
    segments: json[] <<mỗi đoạn: người nói, tin gốc>>
    text: str <<bản chụp>>
    source_at: datetime?
  }
  class BoardItem <<ws_board_items>> {
    number: int
    kind: idea | note
    body: str
    status: proposed | discussing\n| decided | rejected
    reason: str?
    created_by_kind: human | agent
    author_label: str?
    parts: json[]? <<"Ghim cả hai">>
    decided_by, decided_at
  }
  class Task <<ws_tasks>> {
    number: int <<"việc N">>
    body: str[200]
    parent_id: str? <<tối đa 3 cấp>>
    assignee_id: str?
    status: doing | done
    created_by, assigned_by, done_at
    --
    unique(workspace_id, number)
  }
  class Brief <<ws_briefs>> {
    built_by: str
    built_at: datetime
    data: json
    markdown: str
  }
}

User "1" -- "1..*" OAuthAccount : đăng nhập bằng >
User "1" -- "0..1" ProviderKey : agent riêng >
User "1" -- "0..*" Conversation : chủ >
Conversation "1" *-- "0..*" Turn
Conversation "0..*" ..> "0..1" Workspace : ngữ cảnh nhóm
User "1" -- "0..*" PrivateHighlight : chủ >
PrivateHighlight ..> Turn : nguồn (bản chụp)
User "1" -- "0..*" ContextDigest
ContextDigest ..> Workspace

User "1" -- "1" Workspace : workspace riêng >
Workspace "1" *-- "0..*" Member
User "1" -- "0..*" Member
Workspace "1" *-- "0..*" JoinRequest
User "1" -- "0..*" JoinRequest : người xin >
Workspace "1" *-- "0..*" Channel : chỉ khi shared
Channel "1" *-- "0..*" Message
User "1" -- "0..*" ChannelRead
ChannelRead ..> Channel
User "1" -- "0..*" Highlight : chủ >
Highlight ..> Message : nguồn (bản chụp)
Workspace "1" *-- "0..*" BoardItem
BoardItem ..> Message : tin nguồn
Workspace "1" *-- "0..*" Brief
Workspace "1" *-- "0..*" Task : bảng phân công
Task "0..1" -- "0..*" Task : việc cha >
Member "0..1" -- "0..*" Task : người phụ trách >
EmailCode ..> OAuthAccount : xác thực email
Message ..> PrivateHighlight : thẻ trích dẫn

note bottom of Highlight
  Chỉ trên tin của người khác (BR-11, BR-22).
  Tối đa ~30 mỗi người mỗi workspace.
end note
note bottom of PrivateHighlight
  Chỉ người tạo thấy, không tự đi đâu (BR-08).
  Chỉ bị xóa khi chủ xóa (BR-09). Tối đa ~200.
end note
note bottom of Task
  Agent chỉ đọc việc chưa xong (BR-39).
  Khóa bảng không chặn đánh dấu xong (BR-38).
end note
note bottom of BoardItem
  decided/rejected bắt buộc reason, không quay ngược,
  chỉ con người làm (BR-20, BR-23).
end note
@enduml
