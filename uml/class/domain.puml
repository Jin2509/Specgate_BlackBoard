@startuml domain
!include ../_style.iuml
title SpecGate: sơ đồ lớp miền dữ liệu
hide empty methods


package "Danh tính" {
  class Profile {
    id: string
    displayName: string
    initial: string
  }
  class OAuthAccount {
    provider: AuthProvider
    userId: string
    login: string
  }
  enum AuthProvider {
    github
    google
  }
}

package "Không gian làm việc" {
  class Workspace {
    id: string
    name: string
    short: string
    kind: WorkspaceKind
    visibility: Visibility
    ownerId: string
    brief: string
    modules: "adom"[]
    --
    isMember(userId): bool
    isOwner(userId): bool
  }
  class Membership <<members[]>> {
    userId: string
    role: MemberRole
    teamRole?: string <<vai trong nhóm, tự ghi>>
  }
  class Channel {
    id: string
    name: string
  }
  enum WorkspaceKind {
    personal
    shared
  }
  enum Visibility {
    hidden
    discoverable
  }
  enum MemberRole {
    owner
    member
  }
}

package "Tham gia" {
  class JoinCode {
    code: string <<7 ký tự>>
    workspaceId: string
    createdBy: string
    createdAt: string
  }
  class JoinRequest {
    id: string
    workspaceId: string
    userId: string
    message: string
    status: JoinStatus
    via: "code" | "explore"
    code?: string
    at: string
    decidedBy?: string
  }
  enum JoinStatus {
    pending
    approved
    rejected
    cancelled
  }
}

package "Kênh chung" {
  class Message {
    id: string
    channelId: string
    senderKind: SenderKind
    senderId: string <<agent: id chủ agent>>
    agentModel?: string <<mô hình lúc gửi>>
    at: string
    body: Segment[]
    list?: string[]
    streaming?: bool
  }
  abstract class Segment <<union>> {
    t: text | mention | command | flag | ref
  }
  abstract class Attachment <<union>> {
    type: stats | run-progress | board-receipt
  }
  enum SenderKind {
    human
    agent
    system
  }
}

package "Bảng ý tưởng" {
  class BoardItem {
    id: string
    number: number
    kind: BoardItemKind
    body: string
    status?: IdeaStatus | QuestionStatus
    reason?: string
    createdBy: {kind: human | agent, id}
    decidedBy?: {id, at}
    at: string
    critiques?: number
  }
  enum BoardItemKind {
    idea
    note
    question
    summary
  }
  enum IdeaStatus {
    proposed
    discussing
    decided
    rejected
  }
  enum QuestionStatus {
    open
    answered
  }
}

package "Workspace riêng" {
  class ProviderKey {
    userId: string
    provider: ProviderKind
    baseUrl?: string
    keyLast4: string
    model: string
    models: string[]
    savedAt: string
    --
    <<key thật nằm trong Vault, chỉ ghi>>
  }
  class PersonalAgent <<suy ra từ ProviderKey>> {
    ownerId: string
    ownerName: string
    provider: ProviderKind
    model: string
    --
    label(): "model của ownerName"
  }
  class Conversation {
    id: string
    ownerId: string
    title: string
    updatedAt: string
    workspaceId?: string <<ngữ cảnh nhóm>>
  }
  class Turn {
    id: string
    role: "user" | "assistant"
    text: string
    at: string
    model?: string
  }
  class AgentContext <<dựng mỗi lời gọi>> {
    ws: Workspace <<đề bài>>
    team: {profile, role, teamRole, agent}[]
    decided: BoardItem[]
    rejected: BoardItem[]
    ownMessages: Message[] <<tin của mình, tự đọc>>
    highlights: Highlight[] <<kèm người nói>>
  }
  enum ProviderKind {
    anthropic
    openai-compatible
  }
}

package "Highlight (trong kênh chung)" {
  class Highlight {
    id: string
    ownerId: string <<người bôi đen, chỉ người này thấy>>
    workspaceId: string
    channelId: string
    messageId: string
    author: {kind: human | agent, userId, model?}
    text: string <<bản chụp>>
    label: HighlightLabel
    at: string
  }
  enum HighlightLabel {
    important
    review
  }
}

package "Mô-đun ADOM (nhóm khác)" #F8F9FA {
  class Run {
    id: string
    workspaceId: string
    name: string
    dataset: string
    validity: Validity
    importedBy: string
  }
}

' ---- Quan hệ ----
Profile "1" -- "1..*" OAuthAccount : đăng nhập bằng >
OAuthAccount --> AuthProvider

Profile "1" -- "0..*" Membership
Workspace "1" *-- "1..*" Membership : members
Membership --> MemberRole
Workspace --> WorkspaceKind
Workspace --> Visibility
Profile "1" -- "1" Workspace : sở hữu workspace riêng >

Workspace "1" *-- "0..*" Channel : chỉ khi shared
Workspace "1" *-- "0..1" JoinCode : mã hiện hành
Workspace "1" *-- "0..*" JoinRequest
Profile "1" -- "0..*" JoinRequest : người xin >
JoinRequest --> JoinStatus

Channel "1" *-- "0..*" Message
Message "1" *-- "0..*" Segment
Message "1" *-- "0..1" Attachment
Message --> SenderKind
Attachment ..> Run : runId

Workspace "1" *-- "0..*" BoardItem : bảng
BoardItem --> BoardItemKind
BoardItem --> IdeaStatus
BoardItem --> QuestionStatus

Profile "1" -- "0..1" ProviderKey
ProviderKey --> ProviderKind
ProviderKey ..> PersonalAgent : mô hình đang chọn
Message ..> PersonalAgent : senderKind = agent
Profile "1" -- "0..*" Conversation
Conversation "1" *-- "0..*" Turn
Conversation "0..*" ..> "0..1" Workspace : workspaceId (shared)
Conversation ..> AgentContext : gửi kèm mỗi lời gọi
AgentContext ..> Highlight
AgentContext ..> Message
Profile "1" -- "0..*" Highlight : tạo >
Highlight ..> Message : nguồn (bản chụp, không phụ thuộc vòng đời)
Highlight --> HighlightLabel
Workspace "1" *-- "0..*" Run : nếu bật mô-đun adom

note bottom of Highlight
  Chỉ tạo trên tin của người khác (hoặc agent người khác).
  Lưu bản chụp và người nói, không lưu vị trí ký tự.
end note
note bottom of PersonalAgent
  Mỗi người một agent. Agent ở workspace riêng
  và agent gửi tin vào kênh là một, chạy bằng key của chủ nó.
end note
note bottom of BoardItem
  decided/rejected bắt buộc có reason,
  không quay ngược. Agent không chốt được.
end note
@enduml
