' Shows the deployed components of SpecGate Workspace and how a request travels from the browser to the database.
@startuml cls-architecture
!include ../_style.iuml
hide circle
title SpecGate: kiến trúc thành phần (web_ui → backend → CSDL)
hide empty fields
hide empty methods

package "Trình duyệt" {
  class Page <<React client>> {
    ô soạn, chọn vùng highlight
    EventSource kênh (?after=seq)
    đọc luồng trả lời của agent
  }
}

package "web_ui (Next 16)" {
  class Proxy <<src/proxy.ts>> {
    chưa có phiên: /login?next=…
  }
  class Features <<src/features/*>> {
    auth, home, personal, highlight,
    workspace, channel, board, brief,
    join, requests, settings
    --
    index.ts: component, server action
    server.ts: truy vấn phía server, guard
  }
  class Rewrite <<next.config.ts>> {
    /api/:path* → BACKEND_URL/api/:path*
  }
}

package "backend (FastAPI, /api/v1)" {
  class Routers <<app/ws/routers>> {
    /auth  /me  /workspaces  /join-requests
    /workspaces/{id}/channels/{ch}
    /highlights  /private-highlights
    /conversations
  }
  class Deps <<app/ws/deps.py>> {
    current_user (cookie sg_session)
    require_member / require_owner
    not_found cho tài nguyên của người khác
  }
  class Services <<app/ws>> {
    service.py: tin, thẻ, tên, dấu báo
    commands.py: /idea /pin /decide /brief…
    board.py: bảng ý tưởng, bản tổng hợp
    context.py: dựng ngữ cảnh nhóm, tóm tắt tin cũ
  }
  class Security <<app/ws/security.py>> {
    phiên HMAC 30 ngày
    state OAuth chống giả mạo
    mã hóa key bằng Fernet
  }
  class LlmGateway <<app/ws/providers.py>> {
    list_models(key) / stream / complete
    Anthropic | kiểu OpenAI | giả lập
  }
  class Broker <<app/ws/realtime.py>> {
    pub/sub trong một tiến trình
    topic channel:{id}
  }
  class Db <<app/db.py>> {
    SQLAlchemy engine từ DATABASE_URL
    create_all + add_missing_columns
  }
}

package "Hạ tầng dữ liệu" {
  class Sqlite <<mặc định khi dev>>
  class Postgres <<Supabase, khi triển khai>>
}

package "Hệ thống ngoài" {
  class IdP <<Google, GitHub OAuth>>
  class AiProvider <<Anthropic, OpenAI, DeepSeek…>>
}

Page --> Proxy
Proxy --> Features
Features --> Rewrite : fetch phía server\nvà từ trình duyệt
Page ..> Rewrite : SSE kênh,\nluồng trả lời
Rewrite --> Routers
Routers --> Deps
Routers --> Services
Deps --> Security
Services --> LlmGateway : key của chủ agent
Services --> Broker
Services --> Db
Routers ..> Broker : GET …/stream (SSE)
Db --> Sqlite
Db --> Postgres
Routers ..> IdP : /auth/{provider}/start, callback
LlmGateway --> AiProvider

note bottom of Broker
  Một tiến trình backend. Chạy nhiều bản thì thay bằng
  Postgres LISTEN/NOTIFY hoặc Supabase Realtime.
end note
note bottom of Postgres
  Xem docs/supabase-setup.md. Supabase chỉ dùng làm Postgres;
  đăng nhập vẫn do backend tự làm OAuth.
end note
@enduml
