' Details the shared workspace use cases, the channel commands and the paper data features.
@startuml 02-shared-workspace
!include ../_style.iuml
title Ca sử dụng chi tiết: workspace chung, kênh, bảng và số liệu
left to right direction

actor "Người dùng" as User
actor "Thành viên" as Member
actor "Chủ workspace" as Owner
actor "Người nhập số liệu" as Importer
actor "Nhà cung cấp AI" as Ai <<hệ thống>>
actor "Pipeline ADOM" as Adom <<hệ thống>>
Member -|> User
Owner -|> Member
Importer -|> Member

rectangle "Tham gia" {
  usecase "UC09 Tạo workspace chung" as UC09
  usecase "UC10-A Xin tham gia bằng mã" as UC10A
  usecase "UC10-B Xin tham gia qua Khám phá" as UC10B
  usecase "UC11 Duyệt yêu cầu tham gia" as UC11
}

rectangle "Kênh" {
  usecase "UC12 Nhắn tin trong kênh" as UC12
  usecase "UC13 Highlight cho agent" as UC13
  usecase "UC14-A Đưa ý lên bảng\n(/idea, /note, /pin)" as UC14A
  usecase "UC14-B Chuyển ý sang Đang bàn" as UC14B
  usecase "UC14-C Chốt hoặc loại ý\n(/decide)" as UC14C
  usecase "UC15-A Tóm tắt kênh\n(/summarize)" as UC15A
  usecase "UC15-B Dựng và tải bản tổng hợp\n(/brief)" as UC15B
}

rectangle "Số liệu bài báo" {
  usecase "UC16 Nhập lượt chạy" as UC16
  usecase "UC17 Chạy thử trên web" as UC17
  usecase "UC18 Xem số liệu,\n/stats, /task" as UC18
}

rectangle "Thành viên và cài đặt" {
  usecase "UC19-A Tên, vai,\nrời nhóm, xóa thành viên" as UC19A
  usecase "UC19-B Đề bài, mã tham gia,\ntạo kênh" as UC19B
}

User --> UC09
User --> UC10A
User --> UC10B
Owner --> UC11
Member --> UC12
Member --> UC13
Member --> UC14A
Member --> UC14C
Owner --> UC14B
Owner --> UC15A
Owner --> UC15B
Member --> UC18
Importer --> UC16
Owner --> UC17
Member --> UC19A
Owner --> UC19B

UC10A ..> UC11 : chờ chủ duyệt
UC10B ..> UC11 : chờ chủ duyệt
UC14A .> UC12 : <<extend>>\ntin bắt đầu bằng lệnh
UC14C .> UC12 : <<extend>>
UC15A .> UC12 : <<extend>>
UC15B .> UC12 : <<extend>>
UC18 .> UC12 : <<extend>>\n/stats, /task
UC15A --> Ai
UC17 --> Adom
UC17 ..> UC16 : kết quả gắn như\nmột lượt nhập

note right of UC13
  Chỉ trên tin của người khác.
  Tin của mình đã tự vào
  ngữ cảnh agent (BR-11).
end note
@enduml
