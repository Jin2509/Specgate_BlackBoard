' Details the shared workspace use cases and the channel commands.
@startuml uc-02-shared-workspace
!include ../_style.iuml
title Ca sử dụng chi tiết: workspace chung, kênh và bảng
left to right direction

actor "Người dùng" as User
actor "Thành viên" as Member
actor "Chủ workspace" as Owner
actor "Nhà cung cấp AI" as Ai <<hệ thống>>
Member -|> User
Owner -|> Member

rectangle "Tham gia" {
  usecase "UC09 Tạo workspace chung" as UC09
  usecase "UC10-A Xin tham gia bằng mã" as UC10A
  usecase "UC10-B Xin tham gia qua Khám phá" as UC10B
  usecase "UC11 Duyệt yêu cầu tham gia" as UC11
}

rectangle "Kênh" {
  usecase "UC12 Nhắn tin trong kênh" as UC12
  usecase "UC13 Highlight cho agent" as UC13
  usecase "UC14-A Đưa ý lên bảng\n(/idea, /note, /pin)" as UC14A
  usecase "UC14-B Chuyển ý sang Đang bàn" as UC14B
  usecase "UC14-C Chốt hoặc loại ý\n(/decide)" as UC14C
  usecase "UC15-A Tóm tắt kênh\n(/summarize)" as UC15A
  usecase "UC15-B Dựng và tải bản tổng hợp\n(/brief)" as UC15B
}

rectangle "Thành viên và cài đặt" {
  usecase "UC16-A Tên, vai,\nrời nhóm, xóa thành viên" as UC16A
  usecase "UC16-B Đề bài, mã tham gia,\ntạo kênh" as UC16B
  usecase "UC16-C Bảng phân công\n(thêm, nhận, xong, /task)" as UC16C
  usecase "UC16-C Giao việc, sửa, xóa,\nkhóa bảng phân công" as UC16CO
}

User --> UC09
User --> UC10A
User --> UC10B
Owner --> UC11
Member --> UC12
Member --> UC13
Member --> UC14A
Member --> UC14C
Owner --> UC14B
Owner --> UC15A
Owner --> UC15B
Member --> UC16A
Owner --> UC16B
Member --> UC16C
Owner --> UC16CO
UC16C .> UC12 : <<extend>>\n/task

UC10A ..> UC11 : chờ chủ duyệt
UC10B ..> UC11 : chờ chủ duyệt
UC14A .> UC12 : <<extend>>\ntin bắt đầu bằng lệnh
UC14C .> UC12 : <<extend>>
UC15A .> UC12 : <<extend>>
UC15B .> UC12 : <<extend>>
UC15A --> Ai

note right of UC13
  Chỉ trên tin của người khác.
  Tin của mình đã tự vào
  ngữ cảnh agent (BR-11).
end note
@enduml
