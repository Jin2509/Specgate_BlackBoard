' Shows all twenty SRS use cases with their primary and secondary actors.
@startuml 00-overview
!include ../_style.iuml
title Sơ đồ ca sử dụng tổng quát (SRS 0.3)
left to right direction

actor "Khách" as Guest
actor "Người dùng" as User
actor "Thành viên" as Member
actor "Chủ workspace" as Owner
actor "Người nhập số liệu" as Importer
actor "Nhà cung cấp\ndanh tính" as Idp <<hệ thống>>
actor "Nhà cung cấp AI" as Ai <<hệ thống>>
actor "Pipeline ADOM" as Adom <<hệ thống>>

Member -|> User
Owner -|> Member
Importer -|> Member

rectangle "SpecGate Workspace" {
  package "Tài khoản" {
    usecase "UC01 Đăng nhập,\nđăng ký và đăng xuất" as UC01
    usecase "UC02 Trang chủ và\ndấu báo ở thanh bên" as UC02
    usecase "UC20 Làm việc khi\nmạng chập chờn" as UC20
  }
  package "Workspace riêng" {
    usecase "UC03 Thiết lập API key\nvà chọn mô hình" as UC03
    usecase "UC04 Chat với agent riêng" as UC04
    usecase "UC05 Highlight riêng" as UC05
  }
  package "Ngữ cảnh và riêng sang chung" {
    usecase "UC06 Ngữ cảnh nhóm\ncho hội thoại" as UC06
    usecase "UC07 Gửi highlight riêng\nvào kênh" as UC07
    usecase "UC08 Tóm tắt hội thoại\ncho nhóm" as UC08
  }
  package "Workspace chung" {
    usecase "UC09 Tạo workspace chung" as UC09
    usecase "UC10 Xin tham gia\nworkspace chung" as UC10
    usecase "UC11 Duyệt yêu cầu\ntham gia" as UC11
    usecase "UC19 Thành viên và\ncài đặt workspace" as UC19
  }
  package "Kênh, bảng và tổng hợp" {
    usecase "UC12 Nhắn tin trong kênh" as UC12
    usecase "UC13 Highlight cho agent" as UC13
    usecase "UC14 Quản lý bảng ý tưởng" as UC14
    usecase "UC15 Tóm tắt kênh và\nbản tổng hợp" as UC15
  }
  package "Số liệu bài báo" {
    usecase "UC16 Nhập lượt chạy" as UC16
    usecase "UC17 Chạy thử trên web" as UC17
    usecase "UC18 Xem số liệu và\nthẻ số liệu" as UC18
  }
}

Guest --> UC01
User --> UC01
User --> UC02
User --> UC03
User --> UC04
User --> UC05
User --> UC09
User --> UC10
User --> UC20
Member --> UC06
Member --> UC07
Member --> UC08
Member --> UC12
Member --> UC13
Member --> UC14
Member --> UC18
Member --> UC19
Owner --> UC11
Owner --> UC15
Owner --> UC17
Importer --> UC16

UC01 --> Idp
UC03 --> Ai
UC04 --> Ai
UC06 --> Ai
UC08 --> Ai
UC15 --> Ai
UC17 --> Adom
@enduml
