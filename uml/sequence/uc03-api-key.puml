' Sequence diagram of UC03: checking, encrypting and saving an API key.
@startuml seq-uc03
!include ../_style.iuml
title Biểu đồ tuần tự UC03: Thiết lập API key và chọn mô hình
autonumber

actor "Người dùng" as A
boundary "Màn Key và mô hình" as UI
control "MeController" as C
control "LlmGateway" as G
participant "Nhà cung cấp AI" as AI
entity "ProviderKey" as K

A -> UI : chọn nhà cung cấp, dán key
A -> UI : bấm "Kiểm và lưu key"
UI -> C : PUT /me/key {provider, baseUrl, apiKey}
alt E2 - địa chỉ API không hợp lệ
  C --> UI : 400 lỗi ở ô địa chỉ
else
  C -> G : list_models(key)
  G -> AI : gọi thử bằng key
  alt E1 - key sai, hết tiền, mất kết nối
    AI --> G : lỗi
    G --> C : ProviderError
    C --> UI : 400 câu báo lỗi dễ hiểu
  else key dùng được
    AI --> G : danh sách mô hình
    G --> C : models
    C -> K : lưu(secret mã hóa, 4 ký tự cuối, models)
    C --> UI : key "…abcd", danh sách mô hình
    A -> UI : (6) chọn mô hình
    UI -> C : PATCH /me/key {model}
    C -> K : cập nhật model
    C --> UI : agent "‹mô hình› của ‹tên›"
  end
end
opt A3 - xóa key
  A -> UI : bấm xóa, xác nhận
  UI -> C : DELETE /me/key
  C -> K : xóa
end
@enduml
