' Sequence diagram of UC13: saving a highlight for one's own agent from other members' messages.
@startuml seq-uc13
!include ../_style.iuml
title Biểu đồ tuần tự UC13: Highlight cho agent
autonumber

actor "Thành viên" as A
boundary "Kênh chat" as UI
boundary "Hộp thoại Highlight" as DLG
control "HighlightController" as C
entity "Member" as M
entity "Message" as MS
entity "Highlight" as H

A -> UI : (1) bôi đen các đoạn
UI -> UI : (2) bắt vùng chọn theo loại nội dung
alt A1 - chỉ tin của mình
  UI --> A : "Tin của bạn đã tự vào ngữ cảnh agent của bạn"
else
  opt A2 - có lẫn tin của mình
    UI --> A : bỏ phần đó, kèm lời nhắc
  end
  A -> UI : (3) bấm "Highlight cho agent của tôi"
  UI -> DLG : (4) mở hộp thoại, từng đoạn kèm người nói
  loop (5) tới khi ưng
    A -> DLG : thu hẹp hoặc bỏ đoạn
    opt E1 - sửa chữ ở giữa đoạn
      DLG --> A : khóa nút lưu
    end
  end
  A -> DLG : (6) chọn nhãn, ghi chú; (7) "Lưu highlight"
  DLG -> C : POST /workspaces/{ws}/channels/{ch}/highlights {segments, label, note}
  C -> M : kiểm là thành viên
  C -> MS : kiểm tin gốc, không phải tin của mình,\nmỗi đoạn là chữ liền của tin gốc
  C -> H : đếm highlight ở workspace
  alt E2 - đã đủ ~30
    C --> DLG : 409 nhắc bỏ bớt
  else
    C -> H : lưu bản chụp, mỗi đoạn giữ người nói
    C --> DLG : 201
    DLG --> UI : (8) vệt phấn (chỉ mình thấy)
  end
end
opt A3, A4 - sửa hoặc bỏ về sau
  A -> C : PATCH hoặc DELETE /highlights/{id}
  C -> H : cập nhật hoặc xóa
end
@enduml
