' Activity diagram of UC12: sending a channel message and running its command.
@startuml act-uc12
!include ../_style.iuml
title Biểu đồ hoạt động UC12: Nhắn tin trong kênh

|Thành viên|
start
:(1) Soạn tin (gợi ý @ và /);
:(2) Gửi tin;
|Hệ thống|
if (Tin trống?) then (có)
  :[E1] Không gửi;
  stop
else (không)
endif
:(3) Lưu tin, hiện ngay cho mọi người\nđang mở kênh; tin vào ngữ cảnh\nagent của người gửi;
if (Mạng chập chờn?) then (có)
  :[A1] Tự kết nối lại,\nhiện bù tin đã lỡ (UC17);
else (không)
endif
if (Tin bắt đầu bằng lệnh?) then (không)
  stop
else (có)
endif
if (Có quyền dùng lệnh?) then (không)
  :[A2] Trả tin "đây là quyền\ncủa chủ workspace";
  stop
elseif (Đúng cú pháp?) then (không)
  :[E2] Trả tin hướng dẫn cú pháp;
  stop
else (có)
endif
:(4) Thực hiện lệnh: /idea /note /pin /decide (UC14),\n/summarize /brief (UC15),\n/help (danh sách lệnh);
stop
@enduml
