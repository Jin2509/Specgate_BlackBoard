' Mirrors every flow of UC06: choosing a group context (part A) and summarizing one's old messages (part B).
@startuml act-uc06
!include ../_style.iuml
title Hoạt động UC06: Ngữ cảnh nhóm cho hội thoại

start
partition "Phần A. Chọn ngữ cảnh nhóm cho hội thoại" {
  :(1) Người dùng chọn một workspace chung ở ô "Ngữ cảnh nhóm";
  if (Chọn?) then ("Không gắn")
    :[A.A1] Khung "Agent đang đọc" biến mất;\nagent chat như bình thường;
    stop
  else (một workspace)
  endif
  :(2) Lưu lựa chọn ngay; hội thoại có biểu tượng nhóm;\n[A.A2] mỗi hội thoại một workspace tại một thời điểm,\ncâu trả lời cũ giữ ngữ cảnh lúc được viết;
  :(3) Khung "Agent đang đọc" hiện đúng những gì agent nhận:\n- đề bài\n- thành viên: tên, chủ, vai, agent đang dùng\n- ý đã chốt, ý đã loại kèm lý do, lời dặn không đề xuất lại\n- dòng thời gian chung: tin của mình + highlight cho agent\n- mỗi highlight: người nói, nhãn, ghi chú, lời nhắc;
  if (Màn hình hẹp?) then (có)
    :[A.A6] Khung thành ngăn kéo, mở bằng nút ở mép phải;
  else (không)
  endif
  switch (Trong khung, người dùng)
  case (sửa vai)
    :[A.A3] Sửa vai trong nhóm (UC16 A.A2);
  case (bỏ highlight)
    :[A.A4] Bỏ highlight khỏi danh sách và khỏi ngữ cảnh;
  case (không làm gì)
  endswitch
  if (Tin của mình vượt ~50?) then (có)
    :[A.A5] Khung ghi "N tin cũ của bạn đang không được gửi\ncho agent", kèm nút "Tóm tắt tin cũ" (phần B);
  else (không)
  endif
  :(4) Ở câu hỏi tiếp theo, lấy ngữ cảnh mới nhất và gửi kèm;
  if (Còn là thành viên workspace đã chọn?) then (không)
    :[A.E1] Hội thoại vẫn còn nhưng agent\nkhông nhận thông tin nhóm nữa;
  else (còn)
  endif
  note right
  BR-10, BR-11, BR-14: ngoài đoạn đã highlight,
  agent không đọc tin nào khác của người khác;
  bản /summarize không tính là tin của mình.
  end note
}
stop

partition "Phần B. Tóm tắt tin cũ của tôi" {
  start
  :(1) Báo trước: bao nhiêu tin, mấy khối, bao nhiêu khối\ncần gọi agent, bao nhiêu tin giữ nguyên văn;
  :(2) Người dùng bấm "Tóm tắt tin cũ";
  :(3) Chia tin cũ thành khối, cắt tại mốc giờ của từng highlight;
  :(4) Khối dưới ~5 tin giữ nguyên văn; các khối còn lại gửi chung\ntrong một lần gọi agent, bằng key của người dùng;
  if (Key lỗi?) then (có)
    :[B.E1] Báo lỗi dễ hiểu; giữ bản tóm tắt cũ;
    stop
  else (không)
  endif
  :(5) Agent trả bản tóm tắt theo từng khối, mỗi khối ghi\nkhoảng thời gian, nằm đúng chỗ trên dòng thời gian;
  :(6) Khung "Agent đang đọc" hiện bản tóm tắt;\ncác câu hỏi sau gửi kèm bản này;
  if (Người dùng muốn chia sẻ?) then (có)
    :[B.A2] "Lưu vào Highlight riêng để chia sẻ",\nrồi gửi như mọi highlight riêng (UC07 phần A);
  else (không)
  endif
  :[B.A1] Khi lại có tin cũ vượt giới hạn, khung lại báo số tin;\nngười dùng tự quyết có bấm tiếp hay không;
  note right
  Không bao giờ tự tóm tắt khi người dùng chưa bấm.
  Highlight không bao giờ bị cắt hay tóm tắt. Tối đa ~31 khối.
  end note
  stop
}
@enduml
