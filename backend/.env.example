# Copy to .env (never commit .env)

# SQLite for local dev; switch to postgres later, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/specgate
DATABASE_URL=sqlite:///./specgate.db

# Origins allowed to call the API (the Next.js dev server)
CORS_ORIGINS=["http://localhost:3000"]

# ADOM pipeline: absolute path to spec-gate/adom (branch cleanup-scripts)
ADOM_DIR=../../spec-gate/adom
RUNS_DIR=./data/runs
ADOM_TASKS_DIR=config/tasks
HOLDOUT_MAX=200
PIPELINE_ENABLED=true

# Dev without API keys: fixed LLM answers + the three fixture tasks
# (POST /api/runs with taskIds HumanEval/53, HumanEval/13, HumanEval/23)
# LLM_FIXTURES=tests/fixtures/llm.json
# ADOM_TASKS_DIR=tests/fixtures/tasks
# HOLDOUT_MAX=40

# Models the UI can pick (settings, experiments); ids are passed to ADOM as CODER_MODEL / SPEC_MODEL
# MODEL_CATALOG=[{"id":"gpt-4o-mini","name":"GPT-4o mini","family":"openai"},{"id":"claude-sonnet-5-5","name":"Claude Sonnet 5.5","family":"anthropic"}]

# ---------- SpecGate Workspace (app/ws, xem WORKSPACE_API.md) ----------
# Ký phiên đăng nhập và sinh khóa mã hóa API key. BẮT BUỘC đổi trên server: python -c "import secrets;print(secrets.token_urlsafe(48))"
# SECRET_KEY=
# Khóa Fernet riêng cho API key (tùy chọn): python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# KEY_ENCRYPTION_KEY=
# FRONTEND_URL=http://localhost:3000
# PUBLIC_API_URL=http://localhost:8000
# COOKIE_SECURE=false

# OAuth (callback: <PUBLIC_API_URL>/api/auth/google/callback và /api/auth/github/callback)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Đăng nhập giả lập POST /api/auth/dev-login (tắt trên server công khai)
AUTH_DEV_LOGIN=true

# Agent giả tất định cho dev/kiểm thử: không gọi mạng, không tốn tiền.
# Key < 20 ký tự = sai, key kết thúc bằng 0000 = hết hạn mức, câu hỏi kết thúc bằng [fake-error] = lỗi nhà cung cấp.
LLM_FAKE=true
# Cho phép địa chỉ API nội bộ (Ollama trên máy) với kiểu OpenAI
# ALLOW_PRIVATE_BASE_URLS=false
# Số tin của mình tối đa trong ngữ cảnh nhóm (NFR-07)
# CONTEXT_OWN_MESSAGES_MAX=50
# Chạy thử ADOM trên web (flow.md §13): true = mô phỏng tất định, không gọi pipeline. false = chạy pipeline thật
# bằng key và cấu hình do nhóm ADOM cài trên máy chủ.
ADOM_TRIAL_FAKE=true
# ADOM_TRIAL_MAX_TASKS=5
# Giới hạn (flow.md điểm 7): PRIVATE_HIGHLIGHTS_MAX=200, AGENT_HIGHLIGHTS_MAX=30, OWNED_WORKSPACES_MAX=10
