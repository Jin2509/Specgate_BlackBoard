# Chép thành deploy/.env.prod trên server rồi điền (không commit file đó).
# Giữ dấu nháy đơn quanh BASIC_HASH: chuỗi có ký tự "$" mà compose sẽ hiểu nhầm.

DOMAIN=specgate.example.com
BASIC_USER=specgate
# Tạo bằng: docker run --rm caddy:2 caddy hash-password --plaintext 'mat-khau'
BASIC_HASH='$2a$14$thay-bang-chuoi-vua-tao'

# Resource limits of the backend container; keep them within the VPS size.
BACKEND_MEM=1g
BACKEND_CPUS=1
