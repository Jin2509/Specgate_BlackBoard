{
  "version": "0.0.1",
  "configurations": [
    { "name": "web", "url": "http://localhost:3000", "port": 3000 },    {
      "name": "api",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": ["-c", "cd backend && .venv/bin/python -m app.ws.seed && exec .venv/bin/uvicorn app.main:app --port 8000 --reload"],
      "port": 8000
    },
    {
      "name": "web-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "web_ui", "exec", "next", "dev", "-p", "3002"],
      "port": 3002
    },
    {
      "name": "web-build",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "web_ui", "exec", "next", "start", "-p", "3001"],
      "port": 3001
    }
  ]
}
